# Copy to .env for docker compose / local runs (optional; defaults work for local compose).

# --- Postgres (compose service uses these) ---
POSTGRES_PASSWORD=codasaurus

# --- App ---
# DATABASE_URL is set automatically in docker-compose.yml.
# For cargo run against local Postgres:
# DATABASE_URL=postgres://codasaurus:codasaurus@127.0.0.1:5432/codasaurus

PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000

# --- GitHub App (or configure in the dashboard wizard) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_B64=
# GITHUB_WEBHOOK_SECRET=

# --- LLM (optional BYOK) ---
# OPENROUTER_API_KEY=
# CODASAURUS_BASE_URL=http://localhost:11434/v1
# CODASAURUS_MODEL=qwen2.5-coder:7b
# CODASAURUS_OFFLINE=0
# CODASAURUS_LLM_DAILY_BUDGET_USD=

# --- Ops knobs (also editable in Settings → System) ---
# CODASAURUS_QUEUE_WORKERS=2
# CODASAURUS_MAX_CONCURRENT_REVIEWS=4
# CODASAURUS_CONFIG_CACHE_TTL_SECS=60
# CODASAURUS_METRICS_TOKEN=
# CODASAURUS_HSTS=0
